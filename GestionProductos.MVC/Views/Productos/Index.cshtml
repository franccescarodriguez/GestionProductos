@model IEnumerable<GestionProductos.MVC.Models.ProductoViewModel>

@{
    ViewData["Title"] = "Productos";
}

<!-- HEADER -->
<div class="text-center mb-4">
    <!-- Logo + Nombre -->
    <div class="d-inline-flex align-items-center mb-2">
        <img src="~/images/techstore.png"
             style="width:60px; height:auto;"
             class="me-3" />

        <h1 class="fw-bold mb-0">TechStore</h1>
    </div>

    <!-- Descripción centrada -->
    <p class="text-muted">
        Sistema de gestión de productos tecnológicos
    </p>
</div>


<!-- TÍTULO + BOTÓN -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Gestión de Productos</h2>

    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Nuevo Producto
    </a>
</div>

<!-- TABLA -->
<table class="table table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Estado</th>
            <th style="width:180px;">Acciones</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdProducto</td>
                    <td>@item.Nombre</td>
                    <td>S/. @item.Precio</td>
                    <td>@item.Stock</td>

                    <!-- ESTADO CON BADGE -->
                    <td>
                        @if (item.Estado)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>

                    <!-- ACCIONES -->
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@item.IdProducto"
                           class="btn btn-warning btn-sm me-1">
                            Editar
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.IdProducto"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('¿Seguro que deseas eliminar este producto?');">
                            Eliminar
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted py-4">
                    No hay productos registrados
                </td>
            </tr>
        }
    </tbody>
</table>
