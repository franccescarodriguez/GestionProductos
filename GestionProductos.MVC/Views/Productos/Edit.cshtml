@model GestionProductos.MVC.Models.ProductoViewModel

@{
    ViewData["Title"] = "Editar Producto";
}

<h2 class="mb-4">Editar Producto</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="IdProducto" />

            <!-- NOMBRE -->
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <!-- MARCA -->
            <div class="mb-3">
                <label asp-for="Marca" class="form-label"></label>
                <input asp-for="Marca" class="form-control" />
                <span asp-validation-for="Marca" class="text-danger"></span>
            </div>

            <!-- CATEGORÍA -->
            <div class="mb-3">
                <label asp-for="Categoria" class="form-label"></label>
                <select asp-for="Categoria" class="form-select">
                    <option>Computadoras</option>
                    <option>Accesorios</option>
                    <option>Periféricos</option>
                    <option>Componentes</option>
                    <option>Otros</option>
                </select>
                <span asp-validation-for="Categoria" class="text-danger"></span>
            </div>

            <!-- PRECIO -->
            <div class="mb-3">
                <label asp-for="Precio" class="form-label"></label>
                <input asp-for="Precio" class="form-control" />
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>

            <!-- STOCK -->
            <div class="mb-3">
                <label asp-for="Stock" class="form-label"></label>
                <input asp-for="Stock" class="form-control" />
                <span asp-validation-for="Stock" class="text-danger"></span>
            </div>

            <!-- ESTADO -->
            <div class="form-check form-switch mb-4">
                <input asp-for="Estado" class="form-check-input" />
                <label asp-for="Estado" class="form-check-label">
                    Producto activo
                </label>
            </div>

            <!-- BOTONES -->
            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">
                    Volver
                </a>

                <button type="submit" class="btn btn-warning">
                    Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
